# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# CORS
# CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# OTel (deixe em branco para desabilitar export de traces)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Metadados do serviço (usados em logs e OTel)
APP_NAME=casecellshop
APP_VERSION=0.0.1
APP_ENV=development

#--------------------------------------------------------------------
# Simulação de falhas — ajuste para testar os caminhos de erro da saga
#
#   PAYMENT_FAILURE_RATE   0–100  % de chamadas ao gateway que falham     (padrão: 0)
#   PAYMENT_RETRYABLE_RATE 0–100  % das falhas de pagamento que são       (padrão: 50)
#                                 retryáveis (5xx). O restante simula
#                                 cartão recusado (4xx, sem retry).
#   ERP_FAILURE_RATE       0–100  % de chamadas ao ERP que falham         (padrão: 0)
#                                 50% das falhas ERP são 4xx (FAILED),
#                                 50% são 5xx (retryáveis, até 5x).
#
# Exemplos:
#   Tudo funciona (padrão):
#     PAYMENT_FAILURE_RATE=0
#     ERP_FAILURE_RATE=0
#
#   Sempre cartão recusado → PAYMENT_FAILED (reserva mantida):
#     PAYMENT_FAILURE_RATE=100
#     PAYMENT_RETRYABLE_RATE=0
#
#   Gateway sempre indisponível → retries → PAYMENT_FAILED (reserva liberada):
#     PAYMENT_FAILURE_RATE=100
#     PAYMENT_RETRYABLE_RATE=100
#
#   ERP sempre falha (mix 4xx/5xx aleatório):
#     ERP_FAILURE_RATE=100
#--------------------------------------------------------------------
PAYMENT_FAILURE_RATE=0
PAYMENT_RETRYABLE_RATE=50
ERP_FAILURE_RATE=0

# Tempo (em minutos) que a reserva de estoque fica ativa enquanto o pagamento processa
RESERVATION_EXPIRY_MINUTES=15

# Bull Board — porta do dashboard de monitoramento de filas BullMQ
# Acesse http://localhost:BULL_BOARD_PORT após subir o servidor
BULL_BOARD_PORT=3334
